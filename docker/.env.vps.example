# Variables de compose.vps.yml. Copiar a .env.vps en la raiz y poner valores propios.
#
#   cp docker/.env.vps.example .env.vps
#   docker compose -f compose.vps.yml --env-file .env.vps up -d
#
# No es ninguno de los otros dos .env del repo: el de la raiz es para el compose de
# desarrollo y apiBase/.env es para correr el API a mano.

# --- Sitio -------------------------------------------------------------------
# URL publica, con esquema y sin barra final. De aqui salen CORS_ORIGIN y el enlace de
# confirmacion que viaja por WhatsApp.
APP_URL=https://citas.ejemplo.com

# El mismo dominio SIN esquema. Es lo que va en la regla Host() de Traefik. Esta
# separado de APP_URL porque Traefik quiere el nombre pelado y el API quiere el origen
# completo, y meter el esquema en la regla la deja sin coincidir con nada.
DOMINIO=citas.ejemplo.com

# Imagen a desplegar. Con GitHub Actions, la que publica el flujo (en minusculas: GHCR
# no acepta mayusculas). Sin CI, dejar `citas:latest` y compilar con deploy.sh --build.
IMAGEN=ghcr.io/relichtyy/citastemplate:latest

# Zona horaria del negocio. La agenda se lee en horas locales: dejar UTC en un negocio
# que no esta en UTC corre todas las citas.
TZ=America/Bogota

# Puerto en loopback del VPS al que apunta el proxy que termina TLS.
PUERTO_PUBLICO=8080

# Saltos de proxy hasta el API: 1 (el del VPS) + 1 (el nginx del contenedor).
TRUST_PROXY=2

# --- Base de datos -----------------------------------------------------------
MARIADB_ROOT_PASSWORD=cambiar-esta-clave
MARIADB_DATABASE=citas_template
# Usuario propio de la app, sin permiso de CREATE DATABASE: en el VPS se despliega con
# `prisma migrate deploy`, que no usa shadow database.
MARIADB_USER=citas
MARIADB_PASSWORD=cambiar-esta-clave

# --- Sesion ------------------------------------------------------------------
# Uno por entorno, distinto del de desarrollo:
#   openssl rand -hex 32
JWT_SECRET=cambiar-por-64-hex
JWT_EXPIRES_IN=1d

# --- WhatsApp (WAHA) ---------------------------------------------------------
# En false, la app entera funciona y los avisos se escriben al log en vez de salir por
# WhatsApp. Util para el primer despliegue, antes de tener el numero.
WAHA_AUTOSTART=true

# La clave del API de WAHA en claro: es la que el API manda en X-Api-Key.
WAHA_API_KEY=cambiar-esta-clave

# El hash sha512 de la MISMA clave de arriba. WAHA compara contra el hash, asi que su
# proceso nunca ve el texto plano. Se genera con:
#   node -e "console.log('sha512:'+require('crypto').createHash('sha512').update('LA-CLAVE').digest('hex'))"
WAHA_API_KEY_HASH=sha512:cambiar-por-el-hash

# Secreto con el que WAHA firma sus webhooks. Sin el, POST /webhooks/whatsapp se
# rechaza entero.
WAHA_HOOK_HMAC_KEY=cambiar-esta-clave

WAHA_SESSION=default
WAHA_TIMEOUT_MS=15000

# --- Notificaciones ----------------------------------------------------------
# El worker corre dentro del mismo proceso que el API, asi que la reserva lo despierta
# sola: este intervalo solo gobierna reintentos y filas huerfanas.
NOTIFICACIONES_INTERVALO_MS=20000
NOTIFICACIONES_LOTE=20
NOTIFICACIONES_MAX_INTENTOS=4

# --- API externa (sync) ------------------------------------------------------
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_MS=10000
EXTERNAL_API_SYNC_CRON=*/15 * * * *

# --- Respaldo ----------------------------------------------------------------
# Dump diario, verificado, con retencion. El directorio es un bind mount: los archivos
# se ven en el disco del VPS y se pueden copiar afuera con un scp o un rsync.
#
# Un respaldo que vive en el mismo servidor que la base no cubre el caso que mas duele
# (perder el servidor). Copiarlo a otro lado es un cron aparte, y hace falta.
RESPALDOS_DIR=./respaldos
RESPALDO_INTERVALO_S=86400
RESPALDO_RETENCION_DIAS=14
RESPALDO_ESPERA_INICIAL_S=120

# --- Alertas -----------------------------------------------------------------
# A donde avisa el vigia cuando la app deja de responder, y el respaldo cuando falla.
# Vacio = solo queda en el log del contenedor.
# Sirve cualquier webhook que acepte un POST: Discord, Slack, ntfy, Telegram.
#   json  (por defecto) manda {"content": "...", "text": "..."}  → Discord, Slack
#   texto manda el mensaje pelado                                 → ntfy
ALERTA_WEBHOOK_URL=
ALERTA_FORMATO=json
# Prefijo de los mensajes. Con varios negocios en un mismo panel, es lo que dice cual es.
ALERTA_ETIQUETA=citas

VIGIA_INTERVALO_S=60
# Fallos seguidos antes de avisar. Con 3 y 60 s, un despliegue normal no dispara nada.
VIGIA_UMBRAL=3

# --- Recursos ----------------------------------------------------------------
# Memoria del contenedor de la app (WAHA + API + nginx juntos) y techo de heap de cada
# uno de los dos procesos Node. Los tres numeros van de la mano: HEAP_WAHA_MB +
# HEAP_API_MB tienen que caber en MEM_LIMIT dejando sitio para nginx y para lo que Node
# usa fuera del heap. Sin los dos techos, ambos procesos heredan el
# --max-old-space-size=16384 que trae la imagen de WAHA y el contenedor muere por OOM.
MEM_LIMIT=1500m
HEAP_WAHA_MB=900
HEAP_API_MB=320
