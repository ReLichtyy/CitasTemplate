// Modelo de datos. Invariantes y decisiones: 01-modelo-datos.md (misma carpeta)
//
// Horas del dia se guardan como minutos desde medianoche (0..1439), no como TIME:
// la aritmetica de traslape es trivial y no arrastra zona horaria.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Rol {
  ADMIN
  EMPLEADO
  CLIENTE
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoRestriccion {
  FERIADO
  VACACIONES
  BLOQUEO
}

/// Identidad del negocio que despliega el template. Exactamente una fila, id = 1.
/// Es el unico lugar donde el producto deja de ser generico.
model ConfiguracionNegocio {
  id                    Int      @id @default(1)
  nombre                String
  eslogan               String?
  logoUrl               String?
  colorAcento           String   @default("#aa3bff")
  /// Vocabulario visible. Permite que la misma app diga "Tratamiento" o "Sesion"
  /// sin tocar codigo. Ver 05-marca-y-responsive.md.
  terminoServicio       String   @default("Servicio")
  terminoServicioPlural String   @default("Servicios")
  terminoEmpleado       String   @default("Profesional")
  terminoEmpleadoPlural String   @default("Especialistas")
  telefonoContacto      String?
  emailContacto         String?
  direccion             String?
  /// ISO 4217 y BCP 47. Los precios se formatean con Intl, nunca con un simbolo fijo.
  moneda                String   @default("USD")
  locale                String   @default("es")
  /// Debe configurarse por despliegue. Toda hora se interpreta en esta zona.
  zonaHoraria           String   @default("UTC")
  /// Prefijo internacional con "+", p. ej. "+506". Se le antepone a todo telefono
  /// guardado en forma local antes de mandarlo a un canal externo: un numero como
  /// "88887777" no se entrega a ningun lado. Ver 09-conexion-whatsapp.md.
  prefijoPais           String?
  actualizadoEn         DateTime @updatedAt
}

model Usuario {
  id               String    @id @default(uuid())
  /// Identidad y credencial de login.
  telefono         String    @unique
  email            String?
  /// Hash bcrypt. Nunca se serializa hacia el cliente.
  /// Nulo en las fichas que crea una reserva de invitado: existen para colgar la cita
  /// de un telefono, no para iniciar sesion. El login rechaza a quien no lo tiene.
  password         String?
  nombre           String
  apellido         String?
  rol              Rol       @default(CLIENTE)
  activo           Boolean   @default(true)
  /// Opt-in explicito para avisos por WhatsApp. Sin el no sale un solo mensaje: es
  /// politica de WhatsApp y es lo que sostiene la reputacion del numero.
  aceptaWhatsapp   Boolean   @default(false)
  /// Cuando se dio ese consentimiento. Sin fecha, el opt-in no es demostrable.
  aceptaWhatsappEn DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  empleado         Empleado?
  citasComoCliente Cita[]    @relation("CitaCliente")
  citasRegistradas Cita[]    @relation("CitaRegistradaPor")
}

model Especialidad {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  empleados Empleado[]
}

model Empleado {
  id             String  @id @default(uuid())
  usuarioId      String  @unique
  especialidadId String?
  bio            String? @db.Text
  fotoUrl        String?
  activo         Boolean @default(true)

  usuario       Usuario              @relation(fields: [usuarioId], references: [id])
  especialidad  Especialidad?        @relation(fields: [especialidadId], references: [id])
  servicios     Servicio[]           @relation("EmpleadoServicios")
  citas         Cita[]
  restricciones RestriccionHorario[]
  resenas       Resena[]
}

/// Opinion publica sobre un empleado.
///
/// El autor es un **nombre suelto**, no un `Usuario`: la resena sobrevive a la baja de la
/// ficha de quien la escribio, y el catalogo publico no debe poder usarse para averiguar
/// quien es cliente del negocio. La contrapartida asumida: nada impide dos resenas del
/// mismo cliente hasta que exista el flujo que las crea, que es el que debera atarlas a
/// una cita atendida.
///
/// `publicada` es el interruptor de moderacion: una resena existe desde que se escribe,
/// pero solo sale al catalogo cuando alguien la aprueba. Por defecto no sale.
model Resena {
  id         String   @id @default(uuid())
  empleadoId String
  autor      String   @db.VarChar(80)
  /// 1..5. El rango lo valida el DTO; la base solo guarda el entero.
  puntuacion Int
  comentario String   @db.Text
  /// Cuando se vivio la experiencia, no cuando se digito la fila.
  fecha      DateTime
  publicada  Boolean  @default(false)
  creadaEn   DateTime @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  /// El catalogo publico siempre lee "las publicadas de este empleado, por fecha".
  @@index([empleadoId, publicada, fecha])
}

model Servicio {
  id              String  @id @default(uuid())
  nombre          String
  descripcion     String? @db.Text
  duracionMinutos Int
  precio          Decimal @db.Decimal(10, 2)
  imagenUrl       String?
  activo          Boolean @default(true)

  empleados Empleado[] @relation("EmpleadoServicios")
  citas     Cita[]
}

/// Complemento que suma costo pero nunca duracion.
model ServicioAdicional {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  citas CitaAdicional[]
}

/// Como se agrupa el catalogo de productos. Es una tabla y no un enum porque el rubro se
/// expresa como datos: cambiar de negocio es cambiar filas, no migrar el esquema.
model CategoriaProducto {
  id          String  @id @default(uuid())
  nombre      String  @unique
  /// Para que sirve, en una linea. Responde "por que me serviria" antes del detalle.
  promesa     String  @db.VarChar(200)
  descripcion String? @db.Text
  /// Posicion en el catalogo. El orden lo decide el negocio, no el alfabeto.
  orden       Int     @default(0)
  activa      Boolean @default(true)

  productos Producto[]
}

/// Lo que se vende aparte del servicio.
///
/// Los dos indicadores estan separados a proposito, igual que en `EstadoCita`:
/// `activo` es "esta publicado" y `disponible` es "hay existencias hoy". Con uno solo,
/// quedarse sin stock obligaba a despublicar —y a perder la ficha— o a mentir.
model Producto {
  id           String  @id @default(uuid())
  categoriaId  String
  nombre       String
  descripcion  String? @db.Text
  precio       Decimal @db.Decimal(10, 2)
  /// Contenido o formato ("50 ml", "barra de 90 g"). Texto libre: la unidad cambia con
  /// el rubro y encajarla en un numero mas una unidad no sobrevive al primer negocio
  /// que venda algo por par o por juego.
  presentacion String  @db.VarChar(60)
  imagenUrl    String?
  /// Publicado en el catalogo publico. Dar de baja es apagar esto, nunca borrar la fila:
  /// el producto puede estar citado en una ficha vieja.
  activo       Boolean @default(true)
  /// Si hay existencias hoy. Booleano y no una cantidad: publicar el numero exacto
  /// obliga a mantenerlo al dia para que no mienta, y el visitante no lo necesita.
  disponible   Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  categoria CategoriaProducto @relation(fields: [categoriaId], references: [id])

  /// El catalogo publico siempre lee "los activos, agrupados por categoria y en orden".
  @@index([activo, categoriaId])
}

/// Catalogo de estados. Los indicadores deciden que se puede hacer con una cita:
/// esta tabla es configuracion critica, no datos de referencia.
model EstadoCita {
  id                         String  @id @default(uuid())
  codigo                     String  @unique
  nombre                     String
  /// Si es true, una cita en este estado ocupa el espacio del empleado.
  bloqueaDisponibilidad      Boolean @default(true)
  permiteEdicion             Boolean @default(true)
  /// Separados a proposito: con un solo indicador, una cita Confirmada no la podia
  /// cancelar nadie, ni el administrador (deuda ESC-03 del sistema anterior).
  permiteCancelacionCliente  Boolean @default(false)
  permiteCancelacionPersonal Boolean @default(true)
  esFinal                    Boolean @default(false)
  orden                      Int     @default(0)

  citas Cita[]
}

/// Franja de atencion del negocio. Varias filas por dia permiten turnos partidos.
model HorarioAtencion {
  id             String    @id @default(uuid())
  dia            DiaSemana
  minutoApertura Int
  minutoCierre   Int
  activo         Boolean   @default(true)

  @@unique([dia, minutoApertura])
}

/// Bloqueo puntual. empleadoId nulo = aplica a todo el negocio.
model RestriccionHorario {
  id         String          @id @default(uuid())
  tipo       TipoRestriccion
  empleadoId String?
  inicio     DateTime
  fin        DateTime
  motivo     String?

  empleado Empleado? @relation(fields: [empleadoId], references: [id])

  @@index([empleadoId, inicio, fin])
  @@index([inicio, fin])
}

model Cita {
  id              String @id @default(uuid())
  clienteId       String
  /// Quien la digito. Distinto de clienteId cuando el personal reserva a nombre de alguien.
  registradaPorId String
  empleadoId      String
  servicioId      String
  estadoId        String

  inicio      DateTime
  fin         DateTime
  /// Espejo de `inicio` mientras el estado bloquea disponibilidad; NULL cuando no.
  /// MySQL admite NULLs repetidos en un indice unico, asi que una cita cancelada
  /// libera el espacio mientras la fila sobrevive. Ver 02-reservas-concurrencia.md.
  slotOcupado DateTime?

  /// Copias al momento de reservar. Las calcula el servidor, nunca el cliente.
  precioServicio   Decimal @db.Decimal(10, 2)
  costoAdicionales Decimal @default(0) @db.Decimal(10, 2)
  costoTotal       Decimal @db.Decimal(10, 2)

  motivoCancelacion String?  @db.VarChar(255)
  notas             String?  @db.Text
  creadaEn          DateTime @default(now())
  actualizadaEn     DateTime @updatedAt

  cliente           Usuario              @relation("CitaCliente", fields: [clienteId], references: [id])
  registradaPor     Usuario              @relation("CitaRegistradaPor", fields: [registradaPorId], references: [id])
  empleado          Empleado             @relation(fields: [empleadoId], references: [id])
  servicio          Servicio             @relation(fields: [servicioId], references: [id])
  estado            EstadoCita           @relation(fields: [estadoId], references: [id])
  adicionales       CitaAdicional[]
  notificaciones    NotificacionSalida[]
  tokenConfirmacion TokenConfirmacion?

  @@unique([empleadoId, slotOcupado])
  @@index([empleadoId, inicio, fin])
  @@index([clienteId, inicio])
}

/// Join explicito para congelar el precio del adicional al momento de reservar.
model CitaAdicional {
  citaId      String
  adicionalId String
  precio      Decimal @db.Decimal(10, 2)

  cita      Cita              @relation(fields: [citaId], references: [id], onDelete: Cascade)
  adicional ServicioAdicional @relation(fields: [adicionalId], references: [id])

  @@id([citaId, adicionalId])
}

// ─── Notificaciones ──────────────────────────────────────────────────────────
// Ver src/notificaciones/09-conexion-whatsapp.md.

enum CanalNotificacion {
  WHATSAPP
}

enum TipoNotificacion {
  CONFIRMACION_CITA
  RECORDATORIO_CITA
  CANCELACION_CITA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIANDO
  ENVIADA
  FALLIDA
}

/// Outbox. La intencion de enviar se escribe dentro de la transaccion que crea o
/// cambia la cita; el envio real lo hace el worker, despues y fuera de ella. Meter
/// la llamada HTTP en la transaccion le regalaria la latencia de WhatsApp a la tasa
/// de conflictos de reserva, y un envio fallido reventaria una reserva valida.
model NotificacionSalida {
  id     String            @id @default(uuid())
  citaId String
  tipo   TipoNotificacion
  canal  CanalNotificacion @default(WHATSAPP)

  /// Copia congelada del telefono al momento de encolar, igual que
  /// `Cita.precioServicio`. Si el cliente cambia de numero despues, el mensaje ya
  /// encolado no debe salir a un destino que nadie eligio.
  destino   String
  variables Json

  estado           EstadoNotificacion @default(PENDIENTE)
  intentos         Int                @default(0)
  proximoIntentoEn DateTime           @default(now())
  ultimoError      String?            @db.Text
  /// Id del mensaje que devuelve el gateway. Es lo que permite conciliar un acuse de
  /// entrega (`message.ack`) con la fila que lo origino.
  idExterno        String?
  enviadaEn        DateTime?
  /// La marca el acuse de entrega del canal, no el envio. Una fila ENVIADA sin
  /// entrega es informacion operativa: el numero puede no tener WhatsApp.
  entregadaEn      DateTime?
  creadaEn         DateTime           @default(now())

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)

  /// Idempotencia. Una confirmacion por cita, y no mas: sin esto un reintento del
  /// lado del API o un doble clic encolan dos mensajes al mismo numero.
  @@unique([citaId, tipo])
  @@index([estado, proximoIntentoEn])
  @@index([idExterno])
}

/// Token del enlace de confirmacion. En la base vive solo el hash: quien lea la base
/// no puede confirmar citas ajenas.
model TokenConfirmacion {
  /// SHA-256 del token. El token en claro solo existe dentro del enlace enviado.
  hash     String    @id
  citaId   String    @unique
  /// Vence a la hora de inicio de la cita: confirmar una cita ya empezada no
  /// significa nada.
  expiraEn DateTime
  /// Un solo uso. Se marca en la misma transaccion que cambia el estado.
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)
}

/// Idempotencia de los webhooks entrantes: WAHA puede entregar el mismo evento dos
/// veces. La fila es el registro de "esto ya se proceso"; el `@@id` lo garantiza.
model EventoWebhook {
  /// Id del evento tal cual lo manda el proveedor.
  id         String            @id
  canal      CanalNotificacion @default(WHATSAPP)
  tipo       String
  recibidoEn DateTime          @default(now())
}
