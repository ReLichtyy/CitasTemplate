# Variables de docker-compose.yml (raiz). Copiar a .env y poner valores propios.
# Esto NO es el .env del API: ese vive en apiBase/.env y es otro archivo.

# --- MariaDB -----------------------------------------------------------------
# Debe coincidir con la contrasena de DATABASE_URL en apiBase/.env.
MARIADB_ROOT_PASSWORD=dev

# --- WAHA --------------------------------------------------------------------
# El HASH sha512 de la clave del API, NO la clave. WAHA compara contra el hash, asi
# que el secreto en claro no entra al contenedor ni sale en un `docker inspect`.
# El texto plano vive solo en apiBase/.env, que es quien manda la cabecera X-Api-Key.
# Se genera con:
#   node -e "console.log('sha512:'+require('crypto').createHash('sha512').update('LA-CLAVE').digest('hex'))"
#
# Ojo: este archivo entero se inyecta al contenedor con `env_file`, asi que la clave
# en claro NO puede vivir aqui. Si aparece un WAHA_API_KEY sin hashear, el hash deja
# de servir de nada.
WAHA_API_KEY_HASH=sha512:cambiar-por-el-hash-de-la-clave

# Panel del QR en http://localhost:3001/dashboard y referencia del API de WAHA.
# En el VPS los dos van en false: ahi el pareo se hace por /api/{session}/auth/qr.
WAHA_DASHBOARD_ENABLED=true
WAHA_SWAGGER_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambiar-esta-clave

# Secreto con el que WAHA firma los webhooks que manda al API. Se verifica en
# waha-webhook.controller.ts. Ver 09-conexion-whatsapp.md.
WAHA_HOOK_HMAC_KEY=cambiar-esta-clave
